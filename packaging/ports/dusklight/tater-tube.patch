diff --git a/src/m_Do/m_Do_main.cpp b/src/m_Do/m_Do_main.cpp
--- a/src/m_Do/m_Do_main.cpp
+++ b/src/m_Do/m_Do_main.cpp
@@ -501,1 +501,37 @@ static void log_build_info() {
+static const char* tater_disc_validation_error(dusk::iso::ValidationError error) {
+    switch (error) {
+    case dusk::iso::ValidationError::IOError:
+        return "disc-not-readable";
+    case dusk::iso::ValidationError::InvalidImage:
+        return "invalid-disc-image";
+    case dusk::iso::ValidationError::WrongGame:
+        return "wrong-game";
+    case dusk::iso::ValidationError::WrongVersion:
+        return "unsupported-region-or-version";
+    case dusk::iso::ValidationError::Canceled:
+        return "validation-canceled";
+    case dusk::iso::ValidationError::HashMismatch:
+        return "hash-mismatch";
+    case dusk::iso::ValidationError::Success:
+        return "success";
+    case dusk::iso::ValidationError::Unknown:
+    default:
+        return "unknown-disc-error";
+    }
+}
+
+static bool tater_is_legacy_nkit_image(const char* path) {
+    SDL_IOStream* stream = SDL_IOFromFile(path, "rb");
+    if (stream == nullptr) {
+        return false;
+    }
+
+    char header[8]{};
+    const bool found = SDL_SeekIO(stream, 0x200, SDL_IO_SEEK_SET) >= 0 &&
+                       SDL_ReadIO(stream, header, sizeof(header)) == sizeof(header) &&
+                       std::memcmp(header, "NKIT", 4) == 0;
+    SDL_CloseIO(stream);
+    return found;
+}
+
