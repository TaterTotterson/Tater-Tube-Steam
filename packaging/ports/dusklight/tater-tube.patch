+        const auto path = parsed_arg_options["tater-validate-disc"].as<std::string>();
+        dusk::iso::DiscInfo discInfo{};
+        const auto validation = dusk::iso::inspect(path.c_str(), discInfo);
+        if (validation != dusk::iso::ValidationError::Success) {
+            fprintf(stderr, "TATER_DUSKLIGHT_ERROR=%s\n",
+                    tater_disc_validation_error(validation));
+            return 1;
+        }
+
+        // Use the same partition and FST loader as gameplay. This catches
+        // unreadable network files and malformed compressed images before the
+        // window opens, including legacy NKit images that expose a valid disc
+        // header but cannot supply the game filesystem.
+        if (!aurora_dvd_open(path.c_str())) {
+            fprintf(stderr, "TATER_DUSKLIGHT_ERROR=disc-filesystem-open-failed\n");
+            return 1;
+        }
+        aurora_dvd_close();
+
+        fprintf(stdout, "TATER_DUSKLIGHT_DISC_FORMAT=%s\n",
+                tater_is_legacy_nkit_image(path.c_str()) ? "legacy-nkit" : "supported");
+        return 0;
+    }
